{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "persevex-sales-dash",
	"main": "worker/index.ts",
	"vars": {
		"CASHFREE_ALLOW_UNSIGNED": "true"
	},
	"compatibility_date": "2026-10-12",
	"assets": {
		"directory": "./out",
		"binding": "ASSETS",
		"run_worker_first": [
			"/api/*"
		],
	},
	"r2_buckets": [
		{
			"binding": "AVATARS",
			"bucket_name": "persevex-avatars"
		},
		{
			"bucket_name": "persevex-avatars",
			"binding": "persevex_avatars"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "ORGANISATION",
				"class_name": "Organisation",
			},
		],
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"Organisation"
			],
		},
	],
	"account_id": "5b933d8e6234eefc8cb170482322a45c",
}